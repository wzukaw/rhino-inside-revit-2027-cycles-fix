+#if NET
+    static string IsolatedCyclesPath;
+
+    static void ConfigureCyclesNativeResolver(Assembly assembly)
+    {
+      if (!assembly.GetName().Name.Equals("csycles", StringComparison.OrdinalIgnoreCase))
+        return;
+
+      try
+      {
+        NativeLibrary.SetDllImportResolver(assembly, (libraryName, requestingAssembly, searchPath) =>
+        {
+          if (libraryName.Equals("ccycles", StringComparison.OrdinalIgnoreCase))
+            return NativeLibrary.Load(IsolatedCyclesPath);
+
+          return IntPtr.Zero;
+        });
+      }
+      catch (InvalidOperationException)
+      {
+        // A resolver was already registered for this csycles assembly.
+      }
+    }
+
+    static void ConfigureCyclesNativeResolver()
+    {
+      try
+      {
+        var assemblyDirectory = System.IO.Path.GetDirectoryName(Assembly.GetExecutingAssembly().Location);
+        var isolatedCycles = System.IO.Path.Combine(assemblyDirectory, "CyclesIsolated", "ccycles_rir.dll");
+        if (!System.IO.File.Exists(isolatedCycles))
+          return;
+
+        IsolatedCyclesPath = isolatedCycles;
+        AppDomain.CurrentDomain.AssemblyLoad += (sender, args) => ConfigureCyclesNativeResolver(args.LoadedAssembly);
+        foreach (var assembly in AppDomain.CurrentDomain.GetAssemblies())
+          ConfigureCyclesNativeResolver(assembly);
+      }
+      catch (Exception e)
+      {
+        Debug.WriteLine($"Unable to configure the isolated RhinoCycles resolver: {e}");
+      }
+    }
+#endif
